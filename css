:root {
  --primary: #8B1A1A;
  --primary-600: #741414;
  --primary-400: #A83232;
  --primary-soft: rgba(139, 26, 26, 0.08);
  --primary-glow: rgba(139, 26, 26, 0.28);
  --bg: #ffffff;
  --bg-alt: #f5f6f8;
  --card: #ffffff;
  --text: #1a1a1a;
  --text-muted: #6b7280;
  --border: #e5e7eb;
  --shadow-sm: 0 2px 8px rgba(0,0,0,.05);
  --shadow: 0 6px 24px rgba(0,0,0,.07);
  --shadow-lg: 0 16px 48px rgba(0,0,0,.14);
  --radius: 16px;
  --radius-sm: 12px;
  --header-h: 72px;
  --container: 1200px;
  --transition: .28s cubic-bezier(.4,0,.2,1);
}
[data-theme="dark"] {
  --primary: #C0392B; --primary-600: #A93226; --primary-400: #E74C3C;
  --primary-soft: rgba(192,57,43,.15); --primary-glow: rgba(192,57,43,.35);
  --bg: #0f1115; --bg-alt: #16191f; --card: #1b1f27;
  --text: #e8eaed; --text-muted: #9aa0a6; --border: #2a2f3a;
  --shadow-sm: 0 2px 8px rgba(0,0,0,.4); --shadow: 0 6px 24px rgba(0,0,0,.5); --shadow-lg: 0 16px 48px rgba(0,0,0,.65);
}
*,*::before,*::after { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: calc(var(--header-h) + 16px); -webkit-text-size-adjust: 100%; }
body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; font-size: 16px; line-height: 1.65; color: var(--text); background: var(--bg); transition: background var(--transition), color var(--transition); overflow-x: hidden; }
body.no-scroll { overflow: hidden; }
img { max-width: 100%; display: block; }
a { color: var(--primary); text-decoration: none; }
a:hover { color: var(--primary-400); }
h1,h2,h3,h4 { line-height: 1.25; margin: 0 0 .5em; font-weight: 700; }
p { margin: 0 0 1em; }
button { font-family: inherit; cursor: pointer; border: none; background: none; }
.container { width: 100%; max-width: var(--container); margin: 0 auto; padding: 0 20px; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 26px; font-size: .95rem; font-weight: 600; border-radius: 999px; transition: all var(--transition); border: 2px solid transparent; }
.btn-primary { background: var(--primary); color: #fff; box-shadow: 0 6px 20px var(--primary-glow); }
.btn-primary:hover { background: var(--primary-600); color: #fff; transform: translateY(-2px); }
.btn-outline { border-color: var(--primary); color: var(--primary); }
.btn-outline:hover { background: var(--primary); color: #fff; }
.btn-block { width: 100%; }

.notice-bar { background: linear-gradient(90deg, var(--primary), var(--primary-400)); color: #fff; font-size: .88rem; max-height: 120px; overflow: hidden; transition: max-height .4s; }
.notice-bar.hidden { max-height: 0; }
.notice-inner { display: flex; align-items: center; gap: 12px; padding: 10px 20px; }
.notice-text { margin: 0; flex: 1; }
.notice-close { color: #fff; font-size: 1.5rem; width: 32px; height: 32px; border-radius: 50%; }
.notice-close:hover { background: rgba(255,255,255,.2); }

.header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); }
.header.scrolled { box-shadow: var(--shadow); }
.header-inner { height: var(--header-h); display: flex; align-items: center; gap: 20px; }
.logo { display: flex; align-items: center; gap: 12px; color: var(--text); }
.logo-mark { width: 44px; height: 44px; border-radius: 13px; background: linear-gradient(135deg, var(--primary), var(--primary-400)); color: #fff; display: grid; place-items: center; font-weight: 800; }
.logo-text { display: flex; flex-direction: column; line-height: 1.15; }
.logo-title { font-weight: 800; font-size: 1rem; }
.logo-sub { font-size: .72rem; color: var(--text-muted); }
.nav { display: flex; gap: 2px; margin-left: auto; }
.nav-link { padding: 8px 11px; font-size: .84rem; font-weight: 600; color: var(--text-muted); border-radius: 10px; }
.nav-link:hover, .nav-link.active { color: var(--primary); background: var(--primary-soft); }
.header-actions { display: flex; gap: 6px; }
.icon-btn { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; color: var(--text); font-size: 1.1rem; }
.icon-btn:hover { background: var(--primary-soft); color: var(--primary); }
.burger { display: none; flex-direction: column; gap: 5px; }
.burger span { display: block; width: 20px; height: 2px; background: var(--text); border-radius: 2px; transition: all var(--transition); }
.burger.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.burger.active span:nth-child(2) { opacity: 0; }
.burger.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.search-panel { max-height: 0; overflow: hidden; transition: max-height .35s; }
.search-panel.open { max-height: 70vh; overflow-y: auto; border-top: 1px solid var(--border); }
.search-box { display: flex; gap: 12px; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; margin: 16px 0 8px; }
.search-box input { flex: 1; border: none; background: transparent; outline: none; font-size: 1rem; color: var(--text); }
.search-close { font-size: 1.4rem; color: var(--text-muted); width: 28px; height: 28px; border-radius: 50%; }
.search-result { display: block; padding: 12px 16px; border-radius: 12px; color: var(--text); border-bottom: 1px solid var(--border); }
.search-result:hover { background: var(--primary-soft); }
.search-result strong { color: var(--primary); display: block; font-size: .95rem; }
.search-result span { font-size: .85rem; color: var(--text-muted); }
.search-result mark { background: var(--primary); color: #fff; padding: 0 3px; border-radius: 4px; }
.search-empty { padding: 16px; color: var(--text-muted); text-align: center; }

.hero { position: relative; min-height: calc(100vh - var(--header-h)); display: flex; align-items: center; padding: 60px 0 80px; overflow: hidden; }
.hero-content { position: relative; z-index: 2; max-width: 820px; }
.hero-badge { display: inline-flex; padding: 8px 18px; border-radius: 999px; background: var(--primary-soft); color: var(--primary); font-size: .85rem; font-weight: 600; margin-bottom: 24px; }
.hero-title { font-size: clamp(2rem, 6vw, 3.75rem); font-weight: 800; letter-spacing: -1.5px; margin-bottom: 20px; line-height: 1.1; }
.hero-title .accent { color: var(--primary); }
.hero-sub { font-size: clamp(1rem, 2.2vw, 1.18rem); color: var(--text-muted); max-width: 620px; margin-bottom: 34px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 56px; }
.hero-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; max-width: 700px; }
.stat-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px 14px; text-align: center; box-shadow: var(--shadow-sm); transition: all var(--transition); }
.stat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--primary); }
.stat-card strong { display: block; font-size: clamp(1.4rem, 3.5vw, 1.9rem); font-weight: 800; color: var(--primary); }
.stat-card span { font-size: .78rem; color: var(--text-muted); }

.section { padding: 88px 0; }
.section-alt { background: var(--bg-alt); }
.section-head { max-width: 720px; margin: 0 auto 48px; text-align: center; }
.section-tag { display: inline-block; padding: 6px 16px; border-radius: 999px; background: var(--primary-soft); color: var(--primary); font-size: .78rem; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; margin-bottom: 16px; }
.section-title { font-size: clamp(1.6rem, 4vw, 2.4rem); letter-spacing: -.8px; margin-bottom: 14px; }
.section-desc { color: var(--text-muted); font-size: 1.02rem; margin: 0; }

.card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition); }
.card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: var(--primary); }

.about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 22px; margin-bottom: 40px; }
.about-card { padding: 30px 26px; }
.card-icon { width: 54px; height: 54px; border-radius: 15px; background: var(--primary-soft); display: grid; place-items: center; font-size: 1.5rem; margin-bottom: 18px; }
.about-card h3 { font-size: 1.12rem; margin-bottom: 10px; }
.about-card p { font-size: .92rem; color dashed: var(--text-muted); margin: 0; }
.about-info { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1px; background: var(--border); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); }
.info-row { background: var(--card); padding: 20px 24px; display: flex; flex-direction: column; gap: 4px; }
.info-label { font-size: .8rem; color: var(--text-muted); text-transform: uppercase; }
.info-value { font-weight: 700; color: var(--primary); }

.filters { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 40px; }
.filter-btn { padding: 9px 22px; border-radius: 999px; font-size: .88rem; font-weight: 600; color: var(--text-muted); background: var(--card); border: 1px solid var(-- varborder); transition: all var(--transition(--); }
.filter-btn:hover { color: varborder(--primary); border-color: var);(--primary); }
 border.filter-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }
.news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
.news-card { overflow: hidden; display: flex; flex-direction: column; }
.news-thumb { height: 170px; display: grid; place-items: center; position: relative; }
.news-cat { padding: 6px 14px; border-radius: 999px; background: rgba(255,255,255,.92); color: var(--primary); font-size: .74rem; font-weight: 700; text-transform: uppercase; }
.news-body { padding: 22px; flex: 1; }
.news-date { font-size: .78rem; color: var(--text-muted); font-weight: 600; }
.news-body h3 { font-size: 1.05rem; margin: 8px 0 10px; }
.news-body p { font-size: .9rem; color: var(--text-muted); margin: 0; }
.ph-1 { background: linear-gradient(135deg, #8B1A1A, #C0392B); }
.ph-2 { background: linear-gradient(135deg, #2C3E50, #4A6572); }
.ph-3 { background: linear-gradient(135deg, #1E6F5C, #2E9E7E); }
.ph-4 { background: linear-gradient(135deg, #8E44AD, #B06AB3); }
.ph-5 { background: linear-gradient(135deg, #B7791F, #D69E2E); }
.ph-6 { background: linear-gradient(135deg, #7A1616, #A83232); }
.ph-7 { background: linear-gradient(135deg, #2B6CB0, #4299E1); }
.ph-8 { background: linear-gradient(135deg, #9B2C2C, #C53030); }
.ph-9 { background: linear-gradient(135deg, #285E61, #319795); }
.ph-10 { background: linear-gradient(135deg, #553C9A, #805AD5); }
.ph-11 { background: linear-gradient(135deg, #975A16, #B7791F); }
.ph-12 { background: linear-gradient(135deg, #702459, #97266D); }

.schedule-controls { display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; align-items: center; margin-bottom: 28px; }
.select-wrap { display: flex; gap: 10px; align-items: center; font-weight: 600; }
.select-wrap select { padding: 11px 18px; border-radius: 12px; border: 1px solid var(--border); background: var(--card); color: var(--text); font-weight: 600; }
.day-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
.day-tab { min-width: 48px; padding: 10px 14px; border-radius: 12px; font-weight: 700; font-size: .88rem; color: var(--text-muted); background: var(--card); border: 1px solid var(--border); }
.day-tab:hover { color: var(--primary); border-color: var(--primary); }
.day-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }
.schedule-table-wrap { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
.schedule-table { width: 100%; border-collapse: collapse; }
.schedule-table thead { background: var(--primary); color: #fff; }
.schedule-table th { padding: 16px 20px; text-align: left; font-size: .82rem; text-transform: uppercase; }
.schedule-table td { padding: 15px 20px; border-bottom: 1px solid var(--border); }
.schedule-table td:first-child { text-align: center; font-weight: 800; color: var(--primary); }
.schedule-table tbody tr:last-child td { border-bottom: none; }
.schedule-table tbody tr:hover { background: var(--primary-soft); }
.schedule-empty { padding: 40px; text-align: center; color: var(--text-muted); }

.teachers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 24px; }
.teacher-card { padding: 30px 22px; text-align: center; }
.teacher-avatar { width: 96px; height: 96px; border-radius: 50%; margin: 0 auto 18px; display: grid; place-items: center; font-size: 2rem; font-weight: 800; color: #fff; background: linear-gradient(135deg, var(--primary), var(--primary-400)); }
.teacher-card h3 { font-size: 1.05rem; margin-bottom: 4px; }
.teacher-role { font-size: .82rem; color: var(--primary); font-weight: 700; display: block; margin-bottom: 10px; }
.teacher-meta { font-size: .84rem; color: var(--text-muted); margin: 0; }

.achieve-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 24px; }
.achieve-card { padding: 28px 24px; }
.achieve-medal { width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center; font-size: 1.7rem; margin-bottom: 18px; }
.achieve-medal.gold { background: rgba(214,158,46,.16); }
.achieve-medal.silver { background: rgba(160,174,192,.18); }
.achieve-medal.bronze { background: rgba(183,121,31,.16); }
.achieve-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
.achieve-meta { font-size: .78rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 12px; }
.achieve-card p:last-child { font-size: .92rem; color: var(--text-muted); margin: 0; }

.events-layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 28px; align-items: start; }
.calendar { padding: 24px; }
.calendar-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.calendar-head h3 { margin: 0; font-size: 1.1rem; text-transform: capitalize; }
.cal-nav { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; font-size: 1.4rem; color: var(--text); background: var(--bg-alt); border: 1px solid var(--border); }
.cal-nav:hover { background: var(--primary); color: #fff; border-color: var(--primary); }
.calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 8px; }
.calendar-weekdays span { text-align: center; font-size: .74rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.cal-day { aspect-ratio: 1; border-radius: 10px; display: grid; place-items: center; font-size: .88rem; font-weight: 600; color: var(--text); position: relative; }
.cal-day:hover:not(.empty) { background: var(--primary-soft); color: var(--primary); }
.cal-day.empty { pointer-events: none; }
.cal-day.today { border: 1px solid var(--primary); color: var(--primary); font-weight: 800; }
.cal-day.has-event::after { content: ""; position: absolute; bottom: 5px; width: 5px; height: 5px; border-radius: 50%; background: var(--primary); }
.cal-day.selected { background: var(--primary); color: #fff; }
.cal-day.selected::after { background: #fff; }
.events-list { display: flex; flex-direction: column; gap: 14px; }
.events-list-title { font-size: 1.05rem; margin-bottom: 16px; text-transform: capitalize; }
.event-item { background: var(--card); border: 1px solid var(--border); border-left: 4px solid var(--primary); border-radius: var(--radius-sm); padding: 18px 20px; }
.event-item:hover { transform: translateX(4px); box-shadow: var(--shadow); }
.event-time { font-size: .78rem; font-weight: 700; color: var(--primary); text-transform: uppercase; }
.event-item h4 { font-size: 1rem; margin: 6px 0 8px; }
.event-item p { font-size: .88rem; color: var(--text-muted); margin: 0; }
.event-place { display: inline-block; margin-top: 10px; font-size: .78rem; color: var(--text-muted); background: var(--bg-alt); padding: 3px 10px; border-radius: 999px; }
.events-empty { padding: 30px; text-align: center; color: var(--text-muted); background: var(--card); border: 1px-radius: var(--radius-sm); }

.gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
.gallery-item { position: relative; aspect-ratio: 4/3; border-radius: var(--radius-sm); overflow: hidden; cursor: pointer; border: 1px solid var(--border); transition: all var(--transition); }
.gallery-item:hover { transform: scale(1.02); box-shadow: var(--shadow-lg); }
.gallery-item::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.6), transparent 55%); opacity: 0; transition: opacity var(--transition); }
.gallery-item:hover::after { opacity: 1; }
.gallery-label { position: absolute; left: 14px; bottom: 12px; z-index: 2; color: #fff; font-size: .85rem; font-weight: 600; opacity: 0; transition: all var(--transition); }
.gallery-item:hover .gallery-label { opacity: 1; }
.gallery-zoom { position: absolute; top: 12px; right: 12px; z-index: 2; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.9); color: var(--primary); display: grid; place-items: center; opacity: 0; transition: opacity var(--transition); }
.gallery-item:hover .gallery-zoom { opacity: 1; }

.lightbox { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,.93); display: none; align-items: center; justify-content: center; padding: 20px; }
.lightbox.open { display: flex; }
.lb-figure { margin: 0; max-width: 900px; width: 100%; text-align: center; }
.lb-image { width: 100%; aspect-ratio: 16/10; border-radius: var(--radius); }
.lb-figure figcaption { color: #fff; margin-top: 18px; font-size: 1rem; font-weight: 600; }
.lb-close, .lb-nav { position: absolute; color: #fff; background: rgba(255,255,255,.12); border-radius: 50%; display: grid; place-items: center; }
.lb-close:hover, .lb-nav:hover { background: var(--primary); }
.lb-close { top: 20px; right: 20px; width: 48px; height: 48px; font-size: 1.8rem; }
.lb-nav { top: 50%; transform: translateY(-50%); width: 52px; height: 52px; font-size: 2rem; }
.lb-prev { left: 20px; } .lb-next { right: 20px; }

.docs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
.doc-card { display: flex; align-items: center; gap: 16px; padding: 20px 22px; cursor: pointer; }
.doc-icon { width: 48px; height: 48px; border-radius: 13px; background: var(--primary-soft); color: var(--primary); display: grid; place-items: center; font-size: 1.3rem; }
.doc-info { flex: 1; }
.doc-info h4 { font-size: .96rem; margin: 0 0 4px; }
.doc-info span { font-size: .8rem; color: var(--text-muted); }
.doc-arrow { color: var(--text-muted); font-size: 1.2rem; }

.contacts-layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 28px; align-items: start; }
.contact-info { display: flex; flex-direction: column; gap: 16px; }
.contact-card { display: flex; gap: 16px; padding: 22px; }
.contact-icon { width: 48px; height: 48px; border-radius: 13px; background: var(--primary-soft); display: grid; place-items: center; font-size: 1.25rem; }
.contact-card h4 { font-size: .96rem; margin: 0 0 6px; }
.contact-card p { margin: 0; font-size: .9rem; color: var(--text-muted); }
.contact-form { padding: 30px; }
.contact-form h3 { font-size: 1.2rem; margin-bottom: 22px; }
.field { margin-bottom: 18px; }
.field label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: 7px; }
.field input, .field textarea { width: 100%; padding: 13px 16px; border-radius: 12px; border: 1px solid var(--border); background: var(--bg-alt); color: var(--text); font-family: inherit; font-size: .95rem; outline: none; resize: vertical; }
.field input:focus, .field textarea:focus { border-color: var(--primary); background: var(--card); }
.field.invalid input, .field.invalid textarea { border-color: #e53e3e; }
.error { display: block; font-size: .78rem; color: #e53e3e; margin-top: 5px; }

.footer { background: var(--bg-alt); border-top: 1px solid var(--border); padding-top: 60px; }
.footer-inner { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: 40px; padding-bottom: 48px; }
.footer-col h4 { font-size: .95rem; margin-bottom: 16px; }
.footer-desc { font-size: .88rem; color: var(--text-muted); }
.footer-links, .footer-contacts { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
.footer-links a { color: var(--text-muted); font-size: .88rem; }
.footer-links a:hover { color: var(--primary); }
.footer-contacts li { font-size: .88rem; color: var(--text-muted); }
.footer-bottom { border-top: 1px solid var(--border); padding: 22px 0; }
.footer-bottom p { margin: 0; font-size: .82rem; color: var(--text-muted); text-align: center; }

.to-top { position: fixed; right: 22px; bottom: 22px; width: 50px; height: 50px; border-radius: 50%; background: var(--primary); color: #fff; font-size: 1.3rem; display: grid; place-items: center; box-shadow: 0 8px 24px var(--primary-glow); opacity: 0; visibility: hidden; transform: translateY(16px); transition: all var(--transition); z-index: 45; }
.to-top.show { opacity: 1; visibility: visible; transform: translateY(0); }

.toast-wrap { position: fixed; top: calc(var(--header-h) + 16px); right: 20px; z-index: 300; display: flex; flex-direction: column; gap: 10px; }
.toast { background: var(--card); border: 1px solid var(--border); border-left: 4px solid var(--primary); border-radius: var(--radius-sm); padding: 14px 18px; box-shadow: var(--shadow-lg); font-size: .9rem; min-width: 240px; max-width: 340px; }
.toast.success { border-left-color: #38a169; }
.toast.error { border-left-color: #e53e3e; }

.reveal { opacity: 0; transform: translateY(24px); transition: opacity .6s, transform .6s; }
.reveal.visible { opacity: 1; transform: translateY(0); }

.nav-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); opacity: 0; visibility: hidden; transition: all var(--transition); z-index: 40; }
.nav-overlay.show { opacity: 1; visibility: visible; }

@media (max-width: 980px) {
  :root { --header-h: 64px; }
  .burger { display: flex; }
  .nav { position: fixed; top: 0; right: 0; bottom: 0; width: min(320px, 84vw); background: var(--bg); flex-direction: column; padding: calc(var(--header-h) + 20px) 18px 30px; gap: 4px; transform: translateX(100%); transition: transform .34s; box-shadow: -10px 0 40px rgba(0,0,0,.18); z-index: 45; overflow-y: auto; }
  .nav.open { transform: translateX(0); }
  .nav-link { padding: 14px 16px; font-size: 1rem; }
  .nav-link.active { background: var(--primary); color: #fff; }
  .header-actions { margin-left: auto; }
  .logo-sub { display: none; }
  .hero { min-height: auto; padding: 48px 0 64px; }
  .hero-stats { grid-template-columns: repeat(2, 1fr); }
  .section { padding: 64px 0; }
  .events-layout, .contacts-layout { grid-template-columns: 1fr; }
  .footer-inner { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .container { padding: 0 16px; }
  .hero-actions { flex-direction: column; }
  .hero-actions .btn { width: 100%; }
  .news-grid, .teachers-grid, .achieve-grid, .docs-grid { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .schedule-controls { flex-direction: column; align-items: stretch; }
  .day-tabs { justify-content: space-between; }
  .day-tab { flex: 1; min-width: 0; padding: 10px 4px; font-size: .8rem; }
  .calendar { padding: 16px; }
  .footer-inner { grid-template-columns: 1fr; gap: 28px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
  .reveal { opacity: 1; transform: none; }
}
